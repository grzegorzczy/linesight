{
  "uid": "linesight-line",
  "title": "LineSight – linia",
  "tags": [
    "linesight"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Kamera: wady",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "linesight-db"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, class || ' (ślad ' || track_id || ')' AS text, class AS tags\nFROM vision_event\nWHERE $__timeFilter(time) AND class <> 'bottle'"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Stan linii (PackML) i przyczyna postoju",
      "description": "Stan z PLC (Status.StateCurrent) i kod przyczyny (Admin.StopReason, w zapytaniu +1000, żeby numery nie zderzały się ze stanami). Czerwone znaczniki: wady z kamery.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, value AS \"Stan\"\nFROM (SELECT value FROM plc_signal\n      WHERE name = 'iStateCurrent' AND time < $__timeFrom() ORDER BY time DESC LIMIT 1) p\nUNION ALL\nSELECT time, value FROM plc_signal\nWHERE name = 'iStateCurrent' AND $__timeFilter(time)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, value + 1000 AS \"Przyczyna\"\nFROM (SELECT value FROM plc_signal\n      WHERE name = 'iStopReason' AND time < $__timeFrom() ORDER BY time DESC LIMIT 1) p\nUNION ALL\nSELECT time, value + 1000 FROM plc_signal\nWHERE name = 'iStopReason' AND $__timeFilter(time)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#808080"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Clearing",
                  "color": "purple",
                  "index": 0
                },
                "2": {
                  "text": "Stopped",
                  "color": "#808080",
                  "index": 1
                },
                "3": {
                  "text": "Starting",
                  "color": "light-blue",
                  "index": 2
                },
                "4": {
                  "text": "Idle",
                  "color": "blue",
                  "index": 3
                },
                "5": {
                  "text": "Suspended",
                  "color": "orange",
                  "index": 4
                },
                "6": {
                  "text": "Execute",
                  "color": "green",
                  "index": 5
                },
                "7": {
                  "text": "Stopping",
                  "color": "light-blue",
                  "index": 6
                },
                "8": {
                  "text": "Aborting",
                  "color": "dark-red",
                  "index": 7
                },
                "9": {
                  "text": "Aborted",
                  "color": "red",
                  "index": 8
                },
                "11": {
                  "text": "Held",
                  "color": "yellow",
                  "index": 9
                },
                "15": {
                  "text": "Resetting",
                  "color": "light-blue",
                  "index": 10
                },
                "1000": {
                  "text": "–",
                  "color": "transparent",
                  "index": 11
                },
                "1001": {
                  "text": "Stop operatora",
                  "color": "#808080",
                  "index": 12
                },
                "1101": {
                  "text": "Zator",
                  "color": "yellow",
                  "index": 13
                },
                "1201": {
                  "text": "Brak produktu",
                  "color": "orange",
                  "index": 14
                },
                "1301": {
                  "text": "Awaria",
                  "color": "red",
                  "index": 15
                },
                "1302": {
                  "text": "Abort operatora",
                  "color": "dark-red",
                  "index": 16
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Łącza: PLC (most OPC UA) i kamera (Jetson)",
      "description": "Brak danych w czasie offline to awaria łącza, a nie postój linii.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, online::int AS \"PLC\"\nFROM (SELECT online FROM link_status\n      WHERE source = 'plc' AND time < $__timeFrom() ORDER BY time DESC LIMIT 1) p\nUNION ALL\nSELECT time, online::int FROM link_status\nWHERE source = 'plc' AND $__timeFilter(time)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, online::int AS \"Kamera\"\nFROM (SELECT online FROM link_status\n      WHERE source = 'vision' AND time < $__timeFrom() ORDER BY time DESC LIMIT 1) p\nUNION ALL\nSELECT time, online::int FROM link_status\nWHERE source = 'vision' AND $__timeFilter(time)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#808080"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sztuki na minutę: PLC i kamera",
      "description": "PLC: przyrosty licznika udiProdProcessed (licznik symulowany w CODESYS). Kamera: przecięcia linii wg klasy. Na prawdziwej linii obie wartości powinny się zgadzać; różnica to sygnał do diagnostyki.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, sum(d) AS \"PLC\"\nFROM (SELECT time, value - lag(value) OVER (ORDER BY time) AS d\n      FROM plc_signal\n      WHERE name = 'udiProdProcessed'\n        AND time > $__timeFrom()::timestamptz - interval '5 minutes' AND time <= $__timeTo()) x\nWHERE d > 0 AND $__timeFilter(time)\nGROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time_bucket('1 minute', time) AS time,\n       count(*) FILTER (WHERE class = 'bottle')      AS \"kamera: bottle\",\n       count(*) FILTER (WHERE class = 'missing_cap') AS \"kamera: missing_cap\",\n       count(*) FILTER (WHERE class = 'fallen')      AS \"kamera: fallen\"\nFROM vision_event\nWHERE $__timeFilter(time)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": -1,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Czas cyklu [ms]",
      "description": "Rzeczywisty czas między kolejnymi sztukami (od poprawki 14.11 wieczorem; wcześniej zadany, nie zmierzony). xInjSlow wydłuża cykl o 40 %.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, value AS \"czas cyklu\"\nFROM plc_signal\nWHERE name = 'udiCycleTime_ms' AND $__timeFilter(time)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Postoje – dlaczego linia stanęła",
      "description": "Tabela stop_event (usługa diag, E4-02 – E4-04). Pewność: potwierdzona = kamera potwierdza kod PLC, tylko_plc = kamera nic nie wnosi lub była wyłączona, sprzeczna = kamera przeczy kodowi PLC. Klip otwiera się z serwera HTTP na Jetsonie (python3 -m http.server 8080 w ~/linesight_clips).",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t_start AS \"początek\",\n       round(extract(epoch FROM coalesce(t_end, now()) - t_start))::int AS \"trwa [s]\",\n       (t_end IS NULL) AS \"trwa nadal\",\n       cause AS \"przyczyna\", confidence AS \"pewność\",\n       evidence->'secondary'->>0 AS \"druga przyczyna\",\n       stop_reason AS \"kod PLC\",\n       (evidence->'vision'->'counts')::text AS \"kamera w oknie\",\n       evidence->>'note' AS \"uwaga\",\n       clip AS \"klip\"\nFROM stop_event\nWHERE t_start <= $__timeTo() AND coalesce(t_end, now()) >= $__timeFrom()\nORDER BY t_start DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "przyczyna"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "zator": {
                        "color": "yellow",
                        "index": 0
                      },
                      "brak_produktu": {
                        "color": "orange",
                        "index": 1
                      },
                      "awaria": {
                        "color": "red",
                        "index": 2
                      },
                      "operator": {
                        "color": "blue",
                        "index": 3
                      },
                      "restart_plc": {
                        "color": "purple",
                        "index": 4
                      },
                      "nieznana": {
                        "color": "text",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pewność"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "potwierdzona": {
                        "color": "green",
                        "index": 0
                      },
                      "tylko_plc": {
                        "color": "text",
                        "index": 1
                      },
                      "sprzeczna": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trwa nadal"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "TAK",
                        "color": "red",
                        "index": 0
                      },
                      "false": {
                        "text": "",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "klip"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*/([^/]+)$",
                      "result": {
                        "text": "▶ $1",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Otwórz klip",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "początek",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Liczba postojów wg przyczyny",
      "description": "Postoje, które zaczęły się lub trwały w wybranym zakresie czasu.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cause AS \"przyczyna\", count(*) AS \"postoje\"\nFROM stop_event\nWHERE t_start <= $__timeTo() AND coalesce(t_end, now()) >= $__timeFrom()\nGROUP BY cause\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "przyczyna",
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Łączny czas postojów wg przyczyny",
      "description": "Czas postojów przycięty do wybranego zakresu (postój trwający dłużej liczy się tylko w części, która mieści się w zakresie). Analiza Pareto: od czego zacząć poprawę.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cause AS \"przyczyna\",\n       sum(extract(epoch FROM LEAST(coalesce(t_end, now()), $__timeTo()) - GREATEST(t_start, $__timeFrom()))) AS \"czas\"\nFROM stop_event\nWHERE t_start <= $__timeTo() AND coalesce(t_end, now()) >= $__timeFrom()\nGROUP BY cause\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "przyczyna",
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Napęd taśmy: moment na sztukę",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "linesight-db"
      },
      "description": "E4-06, FB_DriveSim w PLC. Moment średni i szczytowy w każdym cyklu. Zużycie (przerywana, prawa oś) to prawda symulacji – w zakładzie jej nie ma, służy tylko do oceny modelu.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, value AS \"moment średni\"\nFROM plc_signal\nWHERE name = 'rTorqueMean_Nm' AND $__timeFilter(time)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, value AS \"moment szczytowy\"\nFROM plc_signal\nWHERE name = 'rTorquePeak_Nm' AND $__timeFilter(time)\nORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "linesight-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, value AS \"zużycie (symulacja)\"\nFROM plc_signal\nWHERE name = 'rSimWear' AND $__timeFilter(time)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none",
          "decimals": 2
